# Шаблон окружения админ-панели FTPN.
# Скопируйте в .env и заполните. Реальный .env коммитить нельзя.

# --- Обязательные: compose не стартует без них ---

# Логин администратора. Дефолта нет намеренно: раньше стоял admin/admin.
ADMIN_LOGIN=

# Пароль администратора.
ADMIN_PASSWORD=

# Список origin через запятую. '*' запрещён: панель принимает запросы
# с Bearer-токеном из JS, и '*' открывает API любому сайту в браузере
# жертвы. Для установки по IP укажите https://<ip>:2663
CORS_ORIGINS=

# --- Необязательные ---

JWT_TTL_MINUTES=60
ENABLE_BROTLI_COMPRESSION=false
TELEGRAM_TOKEN=
BOT_ENABLED=false
SERVICE_NAME=fptn
MAX_USER_SPEED_LIMIT=30
WELCOME_MESSAGE_EN=
WELCOME_MESSAGE_RU=
FPTN_CONFIGS_FOLDER=/opt/fptn/data/fptn-server