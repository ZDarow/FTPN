# Шаблон окружения Telegram-бота администратора FTPN.
# Скопируйте в .env и заполните. Реальный .env коммитить нельзя.

# Токен от @BotFather. Обязателен: без него бот не стартует.
TELEGRAM_API_TOKEN=

# Telegram ID администраторов через запятую. Обязателен.
# Пустое значение запрещает ВСЕХ: бот откажется стартовать.
# Не используйте 0 как «выключить проверку» — так раньше работал обход.
ADMIN_IDS=

# --- Необязательные ---

USERS_FILE=/etc/fptn/users.list
SERVERS_LIST_FILE=/etc/fptn/servers.json
PREMIUM_SERVERS_FILE=/etc/fptn/premium_servers.json
SERVERS_CENSORED_LIST_FILE=/etc/fptn/servers_censored_zone.json
BLACKLIST_FILE=/etc/fptn/blocked_users.txt
LOG_FILE=/var/log/fptn_admin_bot.log
MAX_USER_SPEED_LIMIT=100
SERVICE_NAME=FPTN
ENABLE_BROTLI_COMPRESSION=false