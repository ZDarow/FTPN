#!/usr/bin/env bash
# Обновление Docker-образов
set -Eeuo pipefail
COMPOSE_DIR="/opt/fptn/compose"
PANEL="false"
[[ -d "$COMPOSE_DIR/admin" ]] && PANEL="true"

[[ $EUID -eq 0 ]] || { echo "Нужен root" >&2; exit 1; }

echo "[1/3] VPN-сервер"
( cd "$COMPOSE_DIR/server" && docker compose pull )

echo "[2/3] Telegram-бот"
( cd "$COMPOSE_DIR/bot" && docker compose build --pull )

if [[ "$PANEL" == "true" ]]; then
  echo "[3/4] Админ-панель"
  ( cd "$COMPOSE_DIR/admin" && docker compose pull )
fi

echo "[*] Перезапуск стеков"
( cd "$COMPOSE_DIR/server" && docker compose up -d --remove-orphans )
( cd "$COMPOSE_DIR/bot"    && docker compose up -d --remove-orphans )
[[ "$PANEL" == "true" ]] && ( cd "$COMPOSE_DIR/admin"  && docker compose up -d --remove-orphans )

echo
echo "[+] Готово. Проверь: fptn-status"
docker ps --filter "name=fptn" --format "  {{.Names}}\t{{.Status}}"
