#!/usr/bin/env bash
# Логи контейнеров
# Использование: fptn-logs [server|bot|admin|all] [lines]
set -Eeuo pipefail
SERVICE="${1:-all}"
LINES="${2:-100}"

if [[ "$SERVICE" == "all" ]]; then
  docker ps --filter "name=fptn" --format "{{.Names}}" \
    | while read -r name; do
      [[ -z "$name" ]] && continue
      echo "==== $name ===="
      docker logs --tail "$LINES" "$name" 2>&1 | tail -n "$LINES"
      echo
    done
else
  docker ps --filter "name=fptn-$SERVICE" --format "{{.Names}}" | head -1 \
    | xargs -r docker logs -f --tail "$LINES"
fi
