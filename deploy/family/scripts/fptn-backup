#!/usr/bin/env bash
# Бэкап конфигов
set -Eeuo pipefail
BACKUP_DIR="/var/backups/fptn"
DATA_DIR="/opt/fptn/data/fptn-server"
RETENTION_DAYS="${RETENTION_DAYS:-30}"

[[ $EUID -eq 0 ]] || { echo "Нужен root: sudo fptn-backup" >&2; exit 1; }
mkdir -p "$BACKUP_DIR"

STAMP=$(date +%Y%m%d-%H%M%S)
ARCHIVE="$BACKUP_DIR/fptn-family-$STAMP.tar.gz"

[[ -d "$DATA_DIR" ]] || { echo "$DATA_DIR не найден" >&2; exit 1; }

tar -czf "$ARCHIVE" -C "$(dirname "$DATA_DIR")" "$(basename "$DATA_DIR")" 2>/dev/null

# Ротация
find "$BACKUP_DIR" -name "fptn-family-*.tar.gz" -mtime "+$RETENTION_DAYS" -delete 2>/dev/null

SIZE=$(du -h "$ARCHIVE" | cut -f1)
COUNT=$(find "$BACKUP_DIR" -maxdepth 1 -name "fptn-family-*.tar.gz" | wc -l)
echo "[+] Бэкап: $ARCHIVE ($SIZE)"
echo "    Всего бэкапов: $COUNT (ротация: ${RETENTION_DAYS} дней)"
