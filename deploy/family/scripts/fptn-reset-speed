#!/usr/bin/env bash
# Сбросить пароль пользователя (новый генерируется)
# Использование: fptn-reset-speed <telegram_id>
set -Eeuo pipefail
USERS_FILE="/opt/fptn/data/fptn-server/users.list"
TG_ID="${1:-}"
[[ "$TG_ID" =~ ^[0-9]+$ ]] || { echo "Использование: fptn-reset-speed <telegram_id>" >&2; exit 1; }
[[ -f "$USERS_FILE" ]] || { echo "users.list не найден" >&2; exit 1; }

if ! grep -qE "^${TG_ID} " "$USERS_FILE"; then
  echo "Пользователь $TG_ID не найден"
  exit 1
fi

# Сохраняем текущие speed и premium
LINE=$(grep -E "^${TG_ID} " "$USERS_FILE")
SPEED=$(echo "$LINE" | awk '{print $3}')
PREMIUM=$(echo "$LINE" | awk '{print $4}')

NEW_PASS=$(openssl rand -base64 9 | tr -dc 'A-Za-z0-9' | head -c 12)
NEW_HASH=$(printf '%s' "$NEW_PASS" | sha256sum | awk '{print $1}')

# Заменяем хеш (2-е поле)
sed -i.bak -E "s/^(${TG_ID} )[a-f0-9]+( [0-9]+ [0-9]+)$/\1${NEW_HASH}\2/" "$USERS_FILE"
rm -f "${USERS_FILE}.bak"

docker ps --filter "name=fptn-server" --format "{{.Names}}" | head -1 \
  | xargs -r docker kill -s HUP 2>/dev/null || true

echo "[+] Новый пароль для $TG_ID: $NEW_PASS"
echo
echo "Токен:"
fptn-issue-token "$TG_ID"
