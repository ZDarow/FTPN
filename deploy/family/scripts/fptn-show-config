#!/usr/bin/env bash
# Показать серверы, настройки бота, deploy-конфиг
# Использование: fptn-show-config
set -Eeuo pipefail
DATA_DIR="/opt/fptn/data/fptn-server"

hr() { printf -- '----------------------------------------\n'; }

hr
echo "DEPLOY-КОНФИГУРАЦИЯ (/opt/fptn/deploy-config.env):"
hr
if [[ -f /opt/fptn/deploy-config.env ]]; then
  grep -vE "PASSWORD|TOKEN|SECRET" /opt/fptn/deploy-config.env | sed 's/^/  /'
else
  echo "  не найден"
fi

hr
echo "СЕРВЕРЫ (regular):"
hr
if [[ -f "$DATA_DIR/servers.json" ]]; then
  python3 -m json.tool "$DATA_DIR/servers.json" 2>/dev/null | sed 's/^/  /' || cat "$DATA_DIR/servers.json"
else
  echo "  не найден"
fi

hr
echo "СЕРВЕРЫ (premium):"
hr
if [[ -f "$DATA_DIR/premium_servers.json" ]]; then
  python3 -m json.tool "$DATA_DIR/premium_servers.json" 2>/dev/null | sed 's/^/  /' || cat "$DATA_DIR/premium_servers.json"
else
  echo "  не найден"
fi

hr
echo "СЕРВЕРЫ (censored):"
hr
if [[ -f "$DATA_DIR/servers_censored_zone.json" ]]; then
  python3 -m json.tool "$DATA_DIR/servers_censored_zone.json" 2>/dev/null | sed 's/^/  /' || cat "$DATA_DIR/servers_censored_zone.json"
else
  echo "  не найден"
fi

hr
echo "НАСТРОЙКИ TELEGRAM-БОТА:"
hr
if [[ -f "$DATA_DIR/bot_settings.json" ]]; then
  python3 -c "
import json, sys
with open('$DATA_DIR/bot_settings.json') as f:
    d = json.load(f)
# Скрываем токен
d.pop('telegram_token', None)
print(json.dumps(d, indent=2, ensure_ascii=False))
" | sed 's/^/  /'
else
  echo "  не найден"
fi
