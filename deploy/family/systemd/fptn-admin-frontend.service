[Unit]
Description=FPTN Admin Frontend (nginx)
After=docker.service network-online.target fptn-admin-backend.service fptn-network.service
Requires=docker.service network-online.target fptn-admin-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/fptn/compose/admin
ExecStartPre=-/usr/bin/docker compose down --remove-orphans
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down --remove-orphans
ExecReload=/usr/bin/docker compose pull && /usr/bin/docker compose up -d --remove-orphans
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
