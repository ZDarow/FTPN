[Unit]
Description=FPTN VPN server (Docker Compose)
After=docker.service network-online.target
Requires=docker.service network-online.target
Wants=fptn-network.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/fptn/compose/server
ExecStartPre=-/usr/bin/docker compose down --remove-orphans
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down --remove-orphans
ExecReload=/usr/bin/docker compose pull && /usr/bin/docker compose up -d --remove-orphans
Restart=on-failure
RestartSec=15s
TimeoutStartSec=300

# Чистим висящие tun-устройства при падении
ExecStopPost=-/bin/sh -c 'for d in /sys/class/net/fptn*; do [ -d "$d" ] && ip link set "$(basename $d)" down 2>/dev/null; done'

[Install]
WantedBy=multi-user.target
